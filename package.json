{
  "name": "lexicora-extension",
  "description": "Capture a page or bookmark it, sort it into topics, search it later. Fully offline — your library never leaves your device.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@blocknote/code-block": "^0.52.1",
    "@blocknote/core": "^0.52.1",
    "@blocknote/react": "^0.52.1",
    "@blocknote/shadcn": "^0.52.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/wix-madefor-text": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@webext-core/messaging": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "react-virtuoso": "^4.18.19",
    "rxdb": "^17.6.0",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "21.0.4",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "prosemirror-model": "^1.25.11",
    "prosemirror-view": "^1.42.3"
  }
}
